FROM node:18-alpine

WORKDIR /app

# Copy the entire standalone build (includes node_modules)
COPY .next/standalone/ .

# Ensure .next/static exists
RUN mkdir -p .next
COPY .next/static ./.next/static

# Copy public files
COPY public ./public

EXPOSE 3000

ENV NODE_ENV production
ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

CMD ["node", "server.js"]