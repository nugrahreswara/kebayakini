# Environment Variables Template
# Copy this file to .env.local for local development
# Never commit .env.local to version control

# Application
NEXT_PUBLIC_APP_NAME=Kebayaku
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Integration
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# Google Maps (Optional - for custom integration)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Future Backend Integration (Placeholder)
# NEXT_PUBLIC_API_URL=https://api.kebayaku.com
# NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Email Service (Placeholder for future)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password

# Payment Gateway (Placeholder for future)
# MIDTRANS_SERVER_KEY=your_midtrans_server_key
# MIDTRANS_CLIENT_KEY=your_midtrans_client_key

# Cloud Storage (Placeholder for future)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
