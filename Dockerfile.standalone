FROM node:18-alpine

WORKDIR /app

# Copy the standalone build
COPY .next/standalone/ .

# Create .next directory and copy static files
RUN mkdir -p .next
COPY .next/static ./.next/static

# Copy public directory
COPY public ./public

EXPOSE 3000

ENV NODE_ENV production
ENV PORT 3000
ENV HOSTNAME "0.0.0.0"

CMD ["node", "server.js"]