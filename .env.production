# ============================================================
# Kebaya Kini - Production Environment
# Loaded at runtime by docker-compose (env_file)
# Never baked into the Docker image.
# ============================================================

# Runtime
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0

# Public site identity (canonical + legacy fallback)
NEXT_PUBLIC_SITE_URL=https://kebayakini.web.id
NEXT_PUBLIC_LEGACY_SITE_URL=https://kebayaku.web.id
NEXT_PUBLIC_SITE_NAME=Kebaya Kini

# Google Sheets headless CMS
NEXT_PUBLIC_SHEET_ID=1P06guaQRHlOuaA39q0NVjrcPC9yJOziqWRQRpPQk1lQ
SHEET_KATALOG_URL=https://docs.google.com/spreadsheets/d/1P06guaQRHlOuaA39q0NVjrcPC9yJOziqWRQRpPQk1lQ/gviz/tq?tqx=out:csv&sheet=Katalog
SHEET_JADWAL_URL=https://docs.google.com/spreadsheets/d/1P06guaQRHlOuaA39q0NVjrcPC9yJOziqWRQRpPQk1lQ/gviz/tq?tqx=out:csv&sheet=Jadwal_Sewa
SHEET_REVALIDATE_SECONDS=60

# Contact / booking (WhatsApp)
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890
